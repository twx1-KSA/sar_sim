<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_360_cam">

    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <link name="camera_360_link">
      <pose>0.12 0.03 0.242 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <iyy>0.00004</iyy>
          <izz>0.00004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="panoramic_camera" type="wideanglecamera">
        <gz_frame_id>camera_360_link</gz_frame_id>

        <camera>
          <horizontal_fov>6.2831</horizontal_fov>

          <image>
            <width>1280</width>
            <height>640</height>
          </image>

          <clip>
            <near>0.1</near>
            <far>300</far>
          </clip>

          <lens>
            <type>custom</type>
            <custom_function>
              <c1>1.05</c1>
              <c2>4</c2>
              <f>1.0</f>
              <fun>tan</fun>
            </custom_function>
            <cutoff_angle>3.1415</cutoff_angle>
            <scale_to_hfov>true</scale_to_hfov>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="camera_360_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_360_link</child>
    </joint>

  </model>
</sdf>
