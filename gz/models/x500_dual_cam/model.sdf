<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_dual_cam">

    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- Front-facing RGB camera -->
    <include merge="true">
      <uri>model://mono_cam_front</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>

    <!-- Downward-facing RGB camera -->
    <include merge="true">
      <uri>model://mono_cam_down</uri>
      <pose>0 0 .10 0 1.5707 0</pose>
    </include>

    <!-- Downward-facing thermal camera -->
    <include merge="true">
      <uri>model://thermal_cam_down</uri>
      <pose>.04 0 .10 0 1.5707 0</pose>
    </include>

    <joint name="FrontCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>

    <joint name="DownCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>down_camera_link</child>
      <pose relative_to="base_link">0 0 .10 0 1.5707 0</pose>
    </joint>

    <joint name="ThermalCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>thermal_camera_link</child>
      <pose relative_to="base_link">.04 0 .10 0 1.5707 0</pose>
    </joint>

  </model>
</sdf>
