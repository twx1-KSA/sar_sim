
<?xml version="1.0"?>
<sdf version="1.9">
  <model name="thermal_cam_down">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="thermal_camera_link">
      <inertial>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>

      <visual name="thermal_camera_housing">
        <geometry>
          <box>
            <size>0.03 0.04 0.04</size>
          </box>
        </geometry>
      </visual>

      <sensor name="thermal_camera" type="thermal">
        <gz_frame_id>thermal_camera_link</gz_frame_id>

        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L16</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <plugin filename="gz-sim-thermal-sensor-system"
                name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>373.15</max_temp>
          <resolution>0.01</resolution>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>

