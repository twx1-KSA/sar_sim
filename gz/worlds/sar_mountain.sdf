
<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sar_mountain">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Environment -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- World systems. Declaring ANY <plugin> here makes Gazebo ignore
         PX4's server.config, so every system PX4 needs is listed explicitly. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <!-- Tesla, sensor frame: required by PX4 gz_bridge for a correct heading -->
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>
    <!-- Rendering sensors: RGB cameras, thermal camera, GPU lidar -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.3 -0.8</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- SAR Mountain Heightmap Terrain -->
    <include>
      <uri>model://sar_terrain</uri>
      <name>sar_terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Missing-person target (warm body for thermal detection).
         Random placement in the west search half (drone 0's region), >80 m from the
         takeoff pad. z = terrain height there, since the model origin is at the feet.
         (Earlier test spot next to the pad: -47 -20 28.51.) -->
    <include>
      <uri>model://sar_person</uri>
      <name>missing_person_1</name>
      <pose>-95.8 -200.3 21.61 0 0 0</pose>
    </include>

    <!-- Second target: random placement in the east search half (drone 1's region),
         >80 m from drone 1's takeoff pad (46,6). -->
    <include>
      <uri>model://sar_person</uri>
      <name>missing_person_2</name>
      <pose>158.1 69.1 27.72 0 0 0</pose>
    </include>

    <!-- Landing pad for the confirmation drone (PX4 instance 3), near the area centre.
         The drone tipped over when spawned directly on the terrain here, so it gets a flat
         3 x 3 m platform. Top surface at z = 29.40 (just above the highest terrain under it,
         29.32); the 1 m thick box is sunk into the ground. Spawn the drone at 4,12,29.7. -->
    <model name="confirm_pad">
      <static>true</static>
      <pose>4 12 28.90 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 1</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Landing pad for the backup drone (PX4 instance 2). Top surface at z = 24.40 (terrain
         under it 23.88..24.31). Spawn the drone at 3,-13,24.7. -->
    <model name="backup_pad">
      <static>true</static>
      <pose>3 -13 23.90 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 1</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.9 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GPS Coordinates: Riyadh, Saudi Arabia -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.7136</latitude_deg>
      <longitude_deg>46.6753</longitude_deg>
      <elevation>600</elevation>
    </spherical_coordinates>

  </world>
</sdf>
